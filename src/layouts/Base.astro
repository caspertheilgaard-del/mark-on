---
import '../styles/global.css';
import Topbar from '../components/Topbar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; current?: string; scale?: 'standard' | 'large'; noindex?: boolean }
const { title, description, current, scale = 'standard', noindex = false } = Astro.props;
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={Astro.url.pathname} />
  </head>
  <body>
    <a class="skip-link" href="#indhold">Gå til indhold</a>
    <Topbar />
    <Header current={current} />
    <main id="indhold" data-scale={scale}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
