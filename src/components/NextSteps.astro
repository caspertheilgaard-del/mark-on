---
// "Hvor vil du hen nu?": fire kort der leder videre. Det første kan være rødt (primært).
interface Props { items: { title: string; text: string; href: string; primary?: boolean }[] }
const { items } = Astro.props;
---
<section class="container next" aria-labelledby="next-heading">
  <h2 class="kicker" id="next-heading">Hvor vil du hen nu?</h2>
  <div class="grid">
    {items.map((item) => (
      <a class:list={['go', 'card', { primary: item.primary }]} href={item.href}>
        <span class="t">{item.title}</span>
        <span class="s">{item.text} <span class="arr" aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>
</section>

<style>
  .next { padding-top: 64px; padding-bottom: var(--section); }
  .kicker { margin: 0 0 24px; font-size: 13px; letter-spacing: 3px; text-transform: uppercase; font-weight: 700; color: var(--c-red); }
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .card {
    background: var(--c-surface); color: var(--c-text); border-radius: var(--radius); padding: 28px;
    display: flex; flex-direction: column; justify-content: space-between; align-items: stretch; gap: 16px; min-height: 236px; /* 180 px + padding som i designet (content-box) */
  }
  .t { font-size: 22px; font-weight: 600; line-height: 1.25; }
  .s { font-size: 15px; color: var(--c-red); font-weight: 700; }
  .primary { background: var(--c-red); color: #fff; }
  .primary:hover { color: #fff; background: var(--c-red-hover); }
  .primary .s { color: #fff; font-weight: 400; }
  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
