---
// Billede med hjørne 24 px eller som cirkel, eller en synlig pladsholder til MarkOn leverer billedet.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src?: ImageMetadata;
  alt: string;
  placeholder?: string;
  background?: 'sand' | 'white';
  position?: string;
  ratio?: string;
  circle?: boolean;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  shadow?: boolean;
  class?: string;
  style?: string;
}
const {
  src, alt, placeholder, background = 'sand', position, ratio = '4 / 5', circle = false,
  widths = [400, 600, 880], sizes = '(max-width: 640px) 100vw, 440px', eager = false, shadow = false,
  class: cls, style = '',
} = Astro.props;
const css = `aspect-ratio:${ratio};${position ? `object-position:${position};` : ''}${style}`;
const classes = ['media', { shadow, circle, white: background === 'white' }, cls];
---
{src
  ? <Image class:list={classes} src={src} alt={alt} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} style={css} />
  : <div class:list={[...classes, 'ph']} role="img" aria-label={alt} style={css}>{placeholder ?? alt}</div>}

<style>
  .media { display: block; width: 100%; object-fit: cover; border-radius: var(--radius); background: var(--c-sand); }
  .circle { border-radius: 50%; }
  .white { background: var(--c-surface); }
  .shadow { box-shadow: var(--shadow-image); }
  .ph { display: grid; place-items: center; font-size: 13px; font-weight: 600; text-align: center; padding: 16px; }
</style>
