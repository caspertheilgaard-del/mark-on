---
// Billede i 4:5 med hjørne 24 px, eller en synlig pladsholder til MarkOn leverer billedet.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src?: ImageMetadata;
  alt: string;
  placeholder?: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  shadow?: boolean;
}
const { src, alt, placeholder, widths = [400, 600, 880], sizes = '(max-width: 640px) 100vw, 440px', eager = false, shadow = false } = Astro.props;
---
{src
  ? <Image class:list={['media', { shadow }]} src={src} alt={alt} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  : <div class="media ph" role="img" aria-label={alt}>{placeholder ?? alt}</div>}

<style>
  .media {
    display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover;
    border-radius: var(--radius); background: var(--c-sand);
  }
  .shadow { box-shadow: var(--shadow-image); }
  .ph { display: grid; place-items: center; font-size: 13px; font-weight: 600; text-align: center; padding: 16px; }
</style>
