---
// Tekstpunkter: kort overskrift og lidt tekst, uden kasse og uden billede.
// Tre eller fire på en række. 3 deler sig aldrig i 2+1: de står på række ned til 760 px og går så til én kolonne.
// 4 må gerne stå 2+2 på tablet. (Regel godkendt af Casper 26. nov. 2026.)
interface Item {
  title: string;
  body: string[];
  label?: string;
  value?: string;
  link?: { label: string; href: string };
}
interface Props { items: Item[] }
const { items } = Astro.props;
---
<ul class:list={['points', { four: items.length === 4 }]} role="list">
  {items.map((item) => (
    <li>
      <h3>{item.title}</h3>
      {item.body.map((p) => <p class="txt">{p}</p>)}
      {item.label && <h4 class="kicker lbl">{item.label}</h4>}
      {item.value && <p class="val">{item.value}</p>}
      {item.link && <p class="lnk"><a class="go" href={item.link.href}>{item.link.label} <span class="arr" aria-hidden="true">→</span></a></p>}
    </li>
  ))}
</ul>

<style>
  .points { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; }
  .points.four { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px; }
  li { border-top: 1px solid var(--c-line-strong); padding-top: 24px; }
  h3 { margin: 0 0 10px; font-size: 20px; font-weight: 600; }
  .txt { margin: 0 0 12px; font-size: var(--fs-small); line-height: var(--lh-body); }
  .lbl { margin: 16px 0 6px; letter-spacing: 2px; }
  .val { margin: 0; font-size: var(--fs-small); }
  .lnk { margin: 16px 0 0; }
  @media (max-width: 1100px) {
    .points { gap: 32px; }
    .points.four { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .points, .points.four { grid-template-columns: minmax(0, 1fr); gap: 32px; }
  }
</style>
