---
import { rich } from '../lib/rich';
interface Props {
  heading: string;
  items: { question: string; answer: string[] }[];
  link?: { label: string; href: string };
}
const { heading, items, link } = Astro.props;
---
<section class="container faq" aria-labelledby="faq-heading">
  <div class="wrap">
    <h2 class="h2" id="faq-heading" set:html={rich(heading)} />
    <div class="list">
      {items.map((item, i) => (
        <details open={i === 0}>
          <summary><h3>{item.question}</h3><span class="pl" aria-hidden="true">+</span></summary>
          {item.answer.map((p) => <p>{p}</p>)}
        </details>
      ))}
    </div>
    {link && <p class="more"><a class="go" href={link.href}>{link.label} <span class="arr" aria-hidden="true">→</span></a></p>}
  </div>
</section>

<style>
  .faq { padding-top: var(--section); padding-bottom: 64px; }
  .wrap { max-width: 860px; }
  .h2 { margin-bottom: 32px; }
  .list { border-top: 1px solid var(--c-line-strong); }
  details { border-bottom: 1px solid var(--c-line-strong); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center;
    gap: 16px; padding: 22px 0; min-height: var(--tap); box-sizing: content-box;
  }
  summary::-webkit-details-marker { display: none; }
  summary h3 { margin: 0; font-size: 19px; font-weight: 600; }
  .pl {
    flex: 0 0 auto; width: 36px; height: 36px; border-radius: 50%; background: var(--c-sand);
    display: grid; place-items: center; font-size: 20px; transition: transform 0.3s;
  }
  details[open] .pl { transform: rotate(45deg); background: var(--c-red); color: #fff; }
  details p { margin: 0; padding: 0 56px 12px 0; font-size: 16px; line-height: var(--lh-body); }
  details p:last-child { padding-bottom: 24px; }
  .more { margin: 28px 0 0; }
</style>
