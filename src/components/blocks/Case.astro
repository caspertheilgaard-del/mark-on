---
// Case-bånd: ét billede og én linje (kunde, resultat, "Se casen"). Banner-varianten lægger teksten i et kort på billedet.
import Media from '../Media.astro';
import type { BlockOf } from '../../lib/types';
interface Props { block: BlockOf<'case'> }
const { block } = Astro.props;
---
{block.variant === 'strip' ? (
  <section class="container sec" aria-label={block.kicker} style="--pt:120px;--pb:0px">
    <p class="kicker k">{block.kicker}</p>
    <a class="go strip" href={block.href}>
      <Media {...block.image} ratio="21 / 9" class="casepic" sizes="(max-width: 1340px) 100vw, 1280px" widths={[640, 1280, 1920]} />
      <span class="row"><span class="title">{block.title}</span><span class="lnk">{block.linkLabel} <span class="arr" aria-hidden="true">→</span></span></span>
    </a>
  </section>
) : (
  <section class="banner" aria-label={block.kicker}>
    <Media {...block.image} ratio="auto" class="bannerpic" sizes="100vw" widths={[800, 1440, 2000]} />
    <div class="box card">
      <p class="kicker">{block.kicker}</p>
      <p class="title2">{block.title}</p>
      <a class="go" href={block.href}>{block.linkLabel} <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </section>
)}

<style>
  .k { margin-bottom: 24px; }
  .strip { display: block; color: var(--c-text); }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 20px; }
  .title { font-size: 20px; font-weight: 600; }
  .lnk { font-weight: 700; color: var(--c-red); }
  @media (max-width: 640px) { .strip :global(.casepic) { aspect-ratio: 4 / 3 !important; } }

  .banner { position: relative; background: var(--c-sand); }
  .banner :global(.bannerpic) { height: 540px; border-radius: 0; }
  .card { position: absolute; left: 32px; bottom: 40px; max-width: 504px; /* 440 px + padding */ padding: 32px; }
  .title2 { margin: 10px 0 0; font-size: 26px; font-weight: 600; line-height: 1.25; }
  .card .go { display: inline-block; margin-top: 18px; }
  @media (max-width: 640px) { .card { left: 20px; right: 20px; padding: 24px; } }
</style>
