---
// "Hvor vil du hen nu?": kort der leder videre. Det primære kort er rødt.
import type { BlockOf } from '../../lib/types';
interface Props { block: BlockOf<'next'> }
const { block } = Astro.props;
const cols = block.items.length;
---
<section class:list={['container', 'sec', 'next', block.variant]} aria-labelledby="next-heading" style={block.variant === 'large' ? '--pt:72px;--pb:128px' : '--pt:64px;--pb:128px'}>
  <h2 class="kicker" id="next-heading">{block.kicker}</h2>
  <div class:list={['grid', cols === 3 ? 'three' : 'four']}>
    {block.items.map((item) => (
      <a class:list={['go', 'card', { primary: item.primary }]} href={item.href}>
        <span class="t">{item.title}</span>
        <span class="s">{item.text} <span class="arr" aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>
</section>

<style>
  .kicker { margin-bottom: 24px; }
  .grid { display: grid; gap: 20px; }
  .four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .card {
    background: var(--c-surface); color: var(--c-text); border-radius: var(--radius); padding: 28px;
    display: flex; flex-direction: column; justify-content: space-between; gap: 16px;
    min-height: 236px; /* 180 px + padding som i designet (content-box) */
  }
  .t { font-size: 22px; font-weight: 600; line-height: 1.25; }
  .s { font-size: 15px; color: var(--c-red); font-weight: 700; }
  .primary { background: var(--c-red); color: #fff; }
  .primary:hover { color: #fff; background: var(--c-red-hover); }
  .primary .s { color: #fff; font-weight: 400; }

  .large .kicker { margin-bottom: 32px; }
  .large .card { border-radius: 40px; padding: 32px; min-height: 264px; }
  .large .three .card { min-height: 244px; }
  .large .t { font-size: 24px; }

  @media (max-width: 1100px) { .four { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .three { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) { .four { grid-template-columns: minmax(0, 1fr); } }
</style>
