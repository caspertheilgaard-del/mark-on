---
// Overskrift og korte afsnit med hver sin mellemoverskrift, evt. efterfulgt af et billedgitter.
import Media from '../Media.astro';
import { rich } from '../../lib/rich';
import type { BlockOf } from '../../lib/types';
interface Props { block: BlockOf<'topics'> }
const { block } = Astro.props;
---
<section class="container sec" style="--pt:0px;--pb:128px">
  <div class="text-col">
    <h2 class="h2" set:html={rich(block.heading)} />
    {block.items.map((item) => (
      <>
        <h3>{item.heading}</h3>
        <p>{item.text}</p>
      </>
    ))}
  </div>
  {block.gallery.length > 0 && (
    <div class="gallery">
      {block.gallery.map((img) => <Media {...img} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 400px" />)}
    </div>
  )}
</section>

<style>
  h3 { margin: 40px 0 12px; font-size: 22px; font-weight: 600; color: var(--c-text); }
  p { margin: 0; font-size: var(--fs-body); line-height: var(--lh-body); }
  .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 56px; }
  @media (max-width: 1100px) { .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .gallery { grid-template-columns: minmax(0, 1fr); } }
</style>
