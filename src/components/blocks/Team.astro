---
import Media from '../Media.astro';
import { rich } from '../../lib/rich';
import type { BlockOf } from '../../lib/types';
interface Props { block: BlockOf<'team'> }
const { block } = Astro.props;
---
<section class="container sec" style="--pt:136px;--pb:120px">
  <div class="head">
    <h2 class="h2" set:html={rich(block.heading)} />
    <p>{block.text}</p>
  </div>
  <ul class="four">
    {block.members.map((m) => (
      <li>
        <Media {...m.photo} ratio="3 / 4" sizes="(max-width: 760px) 100vw, 300px" />
        <h3>{m.name}</h3>
        <p class="role">{m.role}</p>
        <a class="go" href={m.link.href}>{m.link.label} <span class="arr" aria-hidden="true">→</span></a>
      </li>
    ))}
  </ul>
</section>

<style>
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 56px; }
  .head p { margin: 0; max-width: 380px; font-size: var(--fs-body); line-height: var(--lh-body); }
  .four { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; align-items: start; }
  li:nth-child(even) { margin-top: 56px; }
  h3 { margin: 18px 0 2px; font-size: 18px; font-weight: 600; }
  .role { margin: 0 0 10px; font-size: 14px; }
  .go { font-size: 14px; }
  @media (max-width: 1100px) { .four { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .four { grid-template-columns: minmax(0, 1fr); }
    li:nth-child(even) { margin-top: 0; }
  }
  /* Som i designet: to kolonner igen på mobil */
  @media (max-width: 640px) { .four { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } }
</style>
