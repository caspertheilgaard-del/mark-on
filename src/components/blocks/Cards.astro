---
// Intro, hvide tekstkort i to kolonner, evt. et afsnit under kortene og et billedgitter (firmagavesiderne).
import Media from '../Media.astro';
import { rich } from '../../lib/rich';
import type { BlockOf } from '../../lib/types';
interface Props { block: BlockOf<'cards'> }
const { block } = Astro.props;
const airy = block.variant === 'airy';
const introGap = airy ? 48 : block.cards.length ? 56 : 40;
---
<section class:list={['container', 'sec', { airy }]} style={`--pt:${block.spaceAbove ?? 0}px;--pb:128px`}>
  <div class="text-col intro" style={`margin-bottom:${introGap}px`}>
    <h2 class="h2" set:html={rich(block.heading)} />
    {block.body.map((p) => <p class="body-text">{p}</p>)}
  </div>
  {block.cards.length > 0 && (
    <div class="cards">
      {block.cards.map((card) => (
        <div class="card">
          <h3>{card.heading}</h3>
          {card.body.map((p) => <p>{p}</p>)}
          {card.checklist && (
            <>
              <p class="cl-head">{card.checklist.heading}</p>
              <ul class="cl">{card.checklist.items.map((i) => <li>{i}</li>)}</ul>
            </>
          )}
          {card.link && <p class="card-link"><a class="go" href={card.link.href}>{card.link.label} <span class="arr" aria-hidden="true">→</span></a></p>}
        </div>
      ))}
    </div>
  )}
  {block.aside && (
    <div class="text-col aside">
      <h3>{block.aside.heading}</h3>
      <p>{block.aside.body}</p>
      {block.aside.link && <p class="card-link"><a class="go" href={block.aside.link.href}>{block.aside.link.label} <span class="arr" aria-hidden="true">→</span></a></p>}
    </div>
  )}
  {block.gallery.length > 0 && (
    <div class="gallery">
      {block.gallery.map((img) => <Media {...img} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 400px" />)}
    </div>
  )}
</section>

<style>
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: stretch; }
  .card { background: var(--c-surface); border-radius: var(--radius); padding: 36px 36px 40px; }
  .card h3, .aside h3 { margin: 0 0 12px; font-size: 22px; font-weight: 600; color: var(--c-text); }
  .card p { margin: 12px 0 0; font-size: 16px; line-height: var(--lh-body); }
  .card h3 + p { margin-top: 0; }
  .card .card-link, .aside .card-link { margin-top: 20px; }
  .card .cl-head { margin: 20px 0 8px; font-size: 15px; font-weight: 700; }
  .cl { margin: 0; padding-left: 20px; font-size: 16px; line-height: var(--lh-body); display: grid; gap: 6px; }
  .aside { margin-top: 64px; }
  .aside p { margin: 0; font-size: var(--fs-body); line-height: var(--lh-body); }
  .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 32px; }
  .airy .gallery { margin-top: 56px; }
  @media (max-width: 1100px) { .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .cards, .gallery { grid-template-columns: minmax(0, 1fr); } }
</style>
