---
// Intro, hvide tekstkort i to kolonner og evt. et billedgitter (firmagavesiderne).
// variant "images" (Employer branding): billedkort (4:5, overskrift i pille, kort tekst under), 3 på række ned til 760 px,
// så 3 aldrig deler sig i 2+1, og evt. ét link under kortene (regel godkendt af Casper 26. nov. 2026).
import Media from '../Media.astro';
import { rich } from '../../lib/rich';
import type { BlockOf } from '../../lib/types';
interface Props { block: BlockOf<'cards'> }
const { block } = Astro.props;
const images = block.variant === 'images';
---
<section class="container sec" style="--pt:0px;--pb:128px">
  <div class="text-col intro" style={`margin-bottom:${block.cards.length ? 56 : 40}px`}>
    <h2 class="h2" set:html={rich(block.heading)} />
    {block.body.map((p) => <p class="body-text">{p}</p>)}
  </div>
  {images && block.cards.length > 0 && (
    <ul class="pics" role="list">
      {block.cards.map((card) => (
        <li>
          <div class="pic">
            {card.image && <Media {...card.image} ratio="4 / 5" sizes="(max-width: 760px) 100vw, 400px" />}
            <h3 class="ttl">{card.heading}</h3>
          </div>
          {card.body.map((p) => <p class="txt">{p}</p>)}
        </li>
      ))}
    </ul>
  )}
  {images && block.link && <p class="more"><a class="go" href={block.link.href}>{block.link.label} <span class="arr" aria-hidden="true">→</span></a></p>}
  {!images && block.cards.length > 0 && (
    <div class="cards">
      {block.cards.map((card) => (
        <div class="card">
          <h3>{card.heading}</h3>
          {card.body.map((p) => <p>{p}</p>)}
          {card.link && (() => {
            const ext = /^https?:\/\//.test(card.link.href);
            return <p class="card-link"><a class="go" href={card.link.href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>{card.link.label}{ext && <span class="visually-hidden"> (åbner i en ny fane)</span>} <span class="arr" aria-hidden="true">→</span></a></p>;
          })()}
        </div>
      ))}
    </div>
  )}
  {block.gallery.length > 0 && (
    <div class="gallery">
      {block.gallery.map((img) => <Media {...img} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 400px" />)}
    </div>
  )}
</section>

<style>
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: stretch; }
  .card { background: var(--c-surface); border-radius: var(--radius); padding: 36px 36px 40px; }
  .card h3 { margin: 0 0 12px; font-size: 22px; font-weight: 600; color: var(--c-text); }
  .card p { margin: 12px 0 0; font-size: 16px; line-height: var(--lh-body); }
  .card h3 + p { margin-top: 0; }
  .card .card-link { margin-top: 20px; }
  .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 32px; }
  @media (max-width: 1100px) { .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .cards, .gallery { grid-template-columns: minmax(0, 1fr); } }
  .pics { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .pic { position: relative; }
  .ttl {
    position: absolute; left: 20px; bottom: 20px; margin: 0; max-width: calc(100% - 40px);
    background: var(--c-cream); color: var(--c-text); padding: 10px 18px; border-radius: 22px;
    font-weight: 700; font-size: 17px; line-height: 1.3;
  }
  .txt { margin: 16px 0 0; font-size: var(--fs-small); line-height: var(--lh-body); }
  .more { margin: 40px 0 0; }
  @media (max-width: 1100px) { .pics { gap: 20px; } .ttl { left: 14px; bottom: 14px; max-width: calc(100% - 28px); font-size: 15px; padding: 8px 14px; } }
  @media (max-width: 760px) { .pics { grid-template-columns: minmax(0, 1fr); gap: 40px; } .ttl { left: 20px; bottom: 20px; font-size: 16px; } }
</style>
