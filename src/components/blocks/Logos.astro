---
import type { BlockOf } from '../../lib/types';
interface Props { block: BlockOf<'logos'> }
const { block } = Astro.props;
---
<section class="logos" aria-label="Kunder">
  <div class="container inner">
    <p class="kicker">{block.label}</p>
    <ul>{block.names.map((n) => <li>{n}</li>)}</ul>
  </div>
</section>

<style>
  .logos { border-top: 1px solid var(--c-line-strong); border-bottom: 1px solid var(--c-line-strong); }
  .inner { padding-top: 30px; padding-bottom: 30px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px; }
  ul { display: contents; list-style: none; }
  li { font-size: 20px; font-weight: 700; color: #a07c74; }
</style>
