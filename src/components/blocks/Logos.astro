---
// Kundebåndet "Brands vi hjælper": navnene kører kontinuerligt (karrusel).
// Undtagelse fra "intet bevæger sig", godkendt af Casper 13. nov. 2026 (kundeønske).
// Ingen pauseknap (ønske oe-20261119131419-z3bn): båndet stopper, når musen holdes over det, eller ved fokus;
// det står stille ved prefers-reduced-motion.
import type { BlockOf } from '../../lib/types';
interface Props { block: BlockOf<'logos'> }
const { block } = Astro.props;
---
<section class="logos" aria-label="Kunder">
  <div class="container inner">
    <p class="kicker">{block.label}</p>
    <div class="marquee" data-marquee>
      <div class="track">
        <ul>{block.names.map((n) => <li>{n}</li>)}</ul>
        <ul aria-hidden="true">{block.names.map((n) => <li>{n}</li>)}</ul>
      </div>
    </div>
  </div>
</section>


<style>
  .logos { border-top: 1px solid var(--c-line-strong); border-bottom: 1px solid var(--c-line-strong); }
  .inner { padding-top: 30px; padding-bottom: 30px; display: flex; align-items: center; gap: 40px; }
  .kicker { flex: 0 0 auto; margin: 0; }
  /* Navnene toner ud ved kanterne, så båndet ikke klippes hårdt */
  .marquee {
    flex: 1 1 auto; min-width: 0; overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track { display: flex; width: max-content; animation: logos-run 30s linear infinite; }
  .marquee:hover .track, .logos:focus-within .track { animation-play-state: paused; }
  ul { display: flex; margin: 0; padding: 0; list-style: none; }
  li { padding-right: 64px; font-size: 20px; font-weight: 700; line-height: 44px; white-space: nowrap; color: var(--c-logo); opacity: 0.75; }
  @keyframes logos-run { to { transform: translateX(-50%); } }


  /* Tablet og mobil: overskriften på egen linje over båndet */
  @media (max-width: 1100px) {
    .inner { flex-wrap: wrap; row-gap: 12px; column-gap: 16px; }
    .kicker { flex: 1 1 auto; }
    .marquee { order: 3; flex: 1 0 100%; }
    li { padding-right: 48px; font-size: 18px; }
  }

  /* Ingen bevægelse: navnene står stille og brydes på flere linjer */
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; width: auto; }
    .marquee { -webkit-mask-image: none; mask-image: none; }
    .track ul:first-child { flex-wrap: wrap; column-gap: 0; }
    .track ul[aria-hidden] { display: none; }
  }
</style>
