---
import type { BlockOf } from '../../lib/types';
interface Props { block: BlockOf<'quote'> }
const { block } = Astro.props;
---
<section class="quote">
  <figure class="band-inner inner" style="--pt:112px;--pb:112px">
    <blockquote><p>{block.text}</p></blockquote>
    <figcaption>{block.author}</figcaption>
  </figure>
</section>

<style>
  .quote { background: var(--c-red); color: var(--c-cream); }
  .inner { max-width: calc(1000px + 2 * var(--gutter)); margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); text-align: center; }
  blockquote { margin: 0; }
  blockquote p { margin: 0; font-weight: 300; font-size: 36px; line-height: 1.3; letter-spacing: -0.5px; }
  figcaption { margin-top: 28px; font-size: 15px; font-weight: 600; }
</style>
