---
import { rich } from '../../lib/rich';
import type { BlockOf } from '../../lib/types';
interface Props { block: BlockOf<'faq'> }
const { block } = Astro.props;
const split = block.variant === 'split';
const pt = block.spaceAbove ?? (split ? 136 : 128);
---
<section class:list={['container', 'sec', 'faq', { split }]} style={`--pt:${pt}px;--pb:64px`} aria-labelledby="faq-heading">
  <div class="head">
    <h2 class="h2" id="faq-heading" set:html={rich(block.heading)} />
    {block.intro && <p class="intro">{block.intro}</p>}
    {block.cta && <a class="btn-outline head-cta" href={block.cta.href}>{block.cta.label}</a>}
    {split && block.link && <p class="head-link"><a class="go" href={block.link.href}>{block.link.label} <span class="arr" aria-hidden="true">→</span></a></p>}
  </div>
  <div class="list">
    {block.items.map((item, i) => (
      <details open={i === 0}>
        <summary><h3>{item.question}</h3><span class="pl" aria-hidden="true">+</span></summary>
        {item.answer.map((p) => <p>{p}</p>)}
      </details>
    ))}
  </div>
  {!split && block.link && <p class="more"><a class="go" href={block.link.href}>{block.link.label} <span class="arr" aria-hidden="true">→</span></a></p>}
</section>

<style>
  .faq:not(.split) .head, .faq:not(.split) .list, .faq:not(.split) .more { max-width: 860px; }
  .faq:not(.split) .h2 { margin-bottom: 32px; }
  .split { display: flex; flex-wrap: wrap; gap: 64px; align-items: flex-start; }
  .split .head { flex: 1 1 340px; min-width: 0; }
  .split .list { flex: 1 1 620px; min-width: 0; }
  .intro { margin: 20px 0 0; font-size: var(--fs-body); line-height: var(--lh-body); max-width: 340px; }
  .head-cta { margin-top: 28px; }
  .head-link { margin: 20px 0 0; }

  .list { border-top: 1px solid var(--c-line-strong); }
  details { border-bottom: 1px solid var(--c-line-strong); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center;
    gap: 16px; padding: 22px 0; min-height: var(--tap); box-sizing: content-box;
  }
  summary::-webkit-details-marker { display: none; }
  summary h3 { margin: 0; font-size: 19px; font-weight: 600; }
  .pl {
    flex: 0 0 auto; width: 36px; height: 36px; border-radius: 50%; background: var(--c-sand);
    display: grid; place-items: center; font-size: 20px; transition: transform 0.3s;
  }
  details[open] .pl { transform: rotate(45deg); background: var(--c-red); color: #fff; }
  details p { margin: 0; padding: 0 56px 12px 0; font-size: 16px; line-height: var(--lh-body); }
  details p:last-child { padding-bottom: 24px; }
  .more { margin: 28px 0 0; }
</style>
