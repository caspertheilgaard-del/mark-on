---
// Tekstpunkter med overskrift og intro (Messer og events): kort overskrift, lidt tekst og evt. en faktalinje.
// Ingen kasser og ingen billeder, så siden kun har én sektion med billedkort (regel godkendt af Casper 26. nov. 2026).
import Points from '../Points.astro';
import { rich } from '../../lib/rich';
import type { BlockOf } from '../../lib/types';
interface Props { block: BlockOf<'features'> }
const { block } = Astro.props;
---
<section class="container sec" style="--pt:0px;--pb:128px">
  <div class="text-col intro">
    <h2 class="h2" set:html={rich(block.heading)} />
    {block.text && <p class="body-text">{block.text}</p>}
  </div>
  <Points items={block.items.map((i) => ({ title: i.title, body: [i.text], label: i.label, value: i.value }))} />
</section>

<style>
  .intro { margin-bottom: 48px; }
</style>
