---
// Eksempler på pakker (Messer og events): hvide kort i en karrusel, man selv bladrer igennem.
// Intet bevæger sig af sig selv. Pilene flytter ét kort; på touch kan man swipe.
import Media from '../Media.astro';
import { rich } from '../../lib/rich';
import type { BlockOf } from '../../lib/types';
interface Props { block: BlockOf<'packs'> }
const { block } = Astro.props;
---
<section class="container sec packs" style="--pt:0px;--pb:136px" aria-roledescription="karrusel" data-packs>
  <div class="text">
    <h2 class="h2" set:html={rich(block.heading)} />
    {block.body.map((p) => <p class="body-text">{p}</p>)}
  </div>
  <div class="nav">
    <button class="arrow" type="button" aria-label="Forrige pakke" data-prev>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <button class="arrow" type="button" aria-label="Næste pakke" data-next>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
  </div>
  <ul class="track" data-track tabindex="0" aria-label="Eksempler på pakker">
    {block.items.map((item, i) => (
      <li class="box card" aria-roledescription="kort" aria-label={`${i + 1} af ${block.items.length}: ${item.title}`}>
        {item.image && <Media {...item.image} ratio="1 / 1" circle class="icon" widths={[120, 240]} sizes="120px" />}
        <h3>{item.title}</h3>
        <p class="txt">{item.text}</p>
        {item.list.length > 0 && (
          <>
            {item.listLabel && <h4 class="kicker lbl">{item.listLabel}</h4>}
            <ul class="list">{item.list.map((l) => <li>{l}</li>)}</ul>
          </>
        )}
      </li>
    ))}
  </ul>
  {block.cta && <p class="cta"><a class="btn" href={block.cta.href}>{block.cta.label}</a></p>}
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-packs]').forEach((sec) => {
    const track = sec.querySelector<HTMLElement>('[data-track]');
    const prev = sec.querySelector<HTMLButtonElement>('[data-prev]');
    const next = sec.querySelector<HTMLButtonElement>('[data-next]');
    if (!track || !prev || !next) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const step = () => {
      const card = track.querySelector<HTMLElement>('.card');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };
    const update = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: reduce ? 'auto' : 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: reduce ? 'auto' : 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .packs { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 32px; align-items: end; }
  .text { max-width: var(--text-col); }
  .nav { display: flex; gap: 12px; }
  .arrow {
    width: var(--tap); height: var(--tap); border-radius: 50%; border: 2px solid var(--c-red); background: transparent;
    color: var(--c-red); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; padding: 0;
  }
  .arrow:hover:not(:disabled) { background: var(--c-red); color: #fff; }
  .arrow:disabled { opacity: 0.35; cursor: default; }
  .track {
    grid-column: 1 / -1; margin: 48px 0 0; padding: 0 0 8px; list-style: none;
    display: flex; gap: 32px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
  }
  .track::-webkit-scrollbar { display: none; }
  /* Lidt af det næste kort titter frem i kanten, så man kan se, at der er flere at rulle til */
  .card { flex: 0 0 calc((100% - 64px) / 3.25); scroll-snap-align: start; padding: 36px; }
  .card :global(.icon) { width: 120px; height: 120px; margin-bottom: 24px; }
  /* Pladsholder i cirklen, til MarkOn sender et billede */
  .card :global(.icon.ph) { padding: 12px; font-size: 11px; line-height: 1.3; }
  h3 { margin: 0 0 10px; font-size: 22px; font-weight: 600; }
  .txt { margin: 0 0 16px; font-size: 15px; line-height: var(--lh-body); }
  .lbl { margin: 0 0 8px; letter-spacing: 2px; }
  .list { margin: 0; padding-left: 18px; font-size: 15px; line-height: var(--lh-body); }
  .cta { grid-column: 1 / -1; margin: 40px 0 0; }
  @media (max-width: 1100px) { .card { flex-basis: calc((100% - 32px) / 2.25); } }
  @media (max-width: 640px) {
    .packs { grid-template-columns: minmax(0, 1fr); }
    .nav { order: 3; margin-top: 20px; }
    .track { margin-top: 32px; gap: 16px; }
    .card { flex-basis: 85%; padding: 28px; }
    .cta { order: 4; }
  }
</style>
